# ---- Local environment (copy to .env and adjust) ----
# .env is git-ignored. Never commit real credentials.

# PostgreSQL + pgvector (docker-compose service "postgres")
POSTGRES_DB=knowledge
POSTGRES_USER=knowledge
POSTGRES_PASSWORD=local_dev_only_change_me
POSTGRES_PORT=5432

# backend-java
PORT=8080

# rag-python
RAG_HOST=127.0.0.1
RAG_PORT=8000
RAG_LOG_LEVEL=INFO

# backend-java -> rag-python service base URL
RAG_BASE_URL=http://localhost:8000
