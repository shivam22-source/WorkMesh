# ---- Local environment (copy to .env and adjust) ----
# .env is git-ignored. Never commit real credentials.

# PostgreSQL + pgvector (docker-compose service "postgres")
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=knowledge
POSTGRES_USER=knowledge
POSTGRES_PASSWORD=local_dev_only_change_me

# Authentication mode: "prod" (strict JWT verification, fail-closed) or "dev" (header simulation allowed)
AUTH_MODE=prod

# JWT Secret Key (required in prod mode, must be at least 32 characters)
# Generate a cryptographically secure random secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_with_a_secure_random_key_of_at_least_32_characters_for_prod
JWT_ALGORITHM=HS256
JWT_ALGORITHMS=HS256
JWT_MAX_TTL_SECONDS=86400

# Server configuration
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Embedding configuration (offline local sentence-transformers)
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Concurrency & backpressure
SEARCH_CONCURRENCY_LIMIT=15
SEARCH_RETRY_AFTER_SECONDS=1
